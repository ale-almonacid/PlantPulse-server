# ❗This file is an example of all required Environment Variables to run this project
# ❗Make sure you create a new .env file with the following variables and assign their corresponding values

PORT=           # PORT to use locally. For example: 5005
ORIGIN=         # URL of Client for CORS. For example: "http://localhost:5173"
DATABASE_URL=   # Pooled Postgres connection used by the app (Supabase: port 6543, add ?pgbouncer=true)
DIRECT_URL=     # Direct Postgres connection used by Prisma migrations (Supabase: port 5432)
CLOUDINARY_NAME= # Cloudinary dashboard → "Cloud name"
CLOUDINARY_KEY= # Cloudinary dashboard → API Keys → "API Key"
CLOUDINARY_SECRET= # Cloudinary dashboard → API Keys → "API Secret"
