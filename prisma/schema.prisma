// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// ℹ️ Generates a typed Prisma Client inside /generated/prisma (run `npm run db:generate`)
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// ℹ️ The connection URL lives in prisma.config.ts (Prisma 7+), not here
datasource db {
  provider = "postgresql"
}

