// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// ℹ️ Generates a typed Prisma Client inside /generated/prisma (run `npm run db:generate`)
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// ℹ️ The connection URL lives in prisma.config.ts (Prisma 7+), not here
datasource db {
  provider = "postgresql"
}

// Models 

model Plant {
  id             String  @id @default(uuid()) @db.Uuid
  name           String  @db.VarChar(100)
  species        String  @db.VarChar(150)
  wateringAmount Int     @map("watering_amount")
  frequency      Int
  imageUrl       String? @map("image_url")
  imagePublicId  String? @map("image_public_id")

  waterLogs WaterLog[]

  @@map("plants")
}

model WaterLog {
  id      String   @id @default(uuid()) @db.Uuid
  plantId String   @map("plant_id") @db.Uuid
  date    DateTime @default(now())

  plant Plant @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@map("water_logs")
}
